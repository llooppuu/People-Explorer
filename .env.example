# --- Database -----------------------------------------------------------
# Local (no docker): localhost:5432
# Inside docker compose: postgres:5432 (already configured in compose file)
DATABASE_URL="postgresql://dpe:dpe_password@localhost:5432/dpe_db?schema=public"

# --- Auth ---------------------------------------------------------------
JWT_SECRET="change_me"

# --- HTTP ---------------------------------------------------------------
PORT=3000
PUBLIC_API_TIMEOUT_MS=5000

# --- AI provider --------------------------------------------------------
# Admin > AI seaded ülesõidab need väärtused; .env on fallback.
# AI_PROVIDER: OLLAMA või OPENAI (vaikimisi OLLAMA, kui admini paneelis pole valitud).
AI_PROVIDER=OLLAMA

# Ollama (Masin B — koolimasin LANis). Näide: http://192.168.1.42:11434
OLLAMA_URL=
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_TIMEOUT_MS=90000

# OpenAI fallback (kasutatakse, kui admini paneelis pole võtit salvestatud).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- EUIPO Persons API --------------------------------------------------
# Optional: enables EUIPO trademark/design applicant and representative search.
EUIPO_CLIENT_ID=
EUIPO_CLIENT_SECRET=
